PORT=3000
DATABASE_URL="postgresql://postgres:[TU-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres"
JWT_SECRET="reemplaza_esto_con_algo_largo_y_random"
ADMIN_SECRET="clave_secreta_para_crear_admins"
TRANSITLAND_API_KEY=tu_key_aqui

# URL del frontend desplegado (Vercel) — se agrega a los orígenes CORS permitidos.
# En local no hace falta: localhost:3000 y :3001 ya están permitidos.
FRONTEND_URL=https://tu-front.vercel.app

# Simulador de GPS en tiempo real.
# SIMULATION_ENABLED=false lo apaga. SIMULATION_INTERVAL_MS = cada cuánto mueve los buses.
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_MS=5000
